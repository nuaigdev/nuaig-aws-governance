# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Amplify: per-environment, generated by `ampx sandbox` / `ampx pipeline-deploy`.
amplify_outputs*.json

# Everything under .amplify is generated, except the checked-in `$amplify/env/*`
# placeholders that let a fresh clone typecheck before the first deploy.
# Each level has to be re-included explicitly: git does not descend into an
# excluded directory, so a negation nested inside one never matches.
.amplify/*
!.amplify/generated/
.amplify/generated/*
!.amplify/generated/env/
